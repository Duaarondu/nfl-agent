{"timestamp": "2026-10-26T02:26:13.779+00:00", "run_id": "afedf66887d9", "agent_name": "analyst", "action": "player_lookup", "target_agent": null, "status": "ok", "retry_count": 0, "sql": "SELECT r.gsis_id, r.full_name, r.team, r.position, r.status, r.week FROM NFLVERSE.rosters r JOIN (SELECT gsis_id, MAX(week) AS week FROM NFLVERSE.rosters WHERE season = 2026 AND REGEXP_REPLACE(LOWER(full_name), ' (jr|sr|ii|iii|iv)[.]?$', '') IN ('mike evans', 'should i', 'i pick', 'pick up', 'up a', 'a ers', 'ers receiver', 'receiver if', 'if evans', 'evans misses', 'misses time', 'should i pick', 'i pick up', 'pick up a', 'up a ers', 'a ers receiver', 'ers receiver if', 'receiver if evans', 'if evans misses', 'evans misses time') GROUP BY gsis_id) latest ON r.gsis_id = latest.gsis_id AND r.week = latest.week WHERE r.season = 2026 AND r.position IN ('QB', 'RB', 'WR', 'TE') ORDER BY r.full_name", "model": null, "rows_returned": 1, "duration_ms": 1340, "query_id": 1, "error": null, "factor": "Player lookup"}

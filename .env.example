# Copy to .env and fill in. Placeholders only; never commit real values.

# --- Data: Zetaris (app/adapters/zetaris.py) ---
# "true" runs SQL with DuckDB against data/sample/ (no Zetaris credentials needed).
SAMPLE_MODE=true
# HTTP(S) origin, no path.
ZETARIS_BASE_URL=http://localhost:3000
ZETARIS_ORG_ID=your-org-id
# Either an API key, or a username and password.
ZETARIS_API_KEY=your-zetaris-api-key
ZETARIS_USERNAME=your-username
ZETARIS_PASSWORD=your-password
# Optional.
ZETARIS_ENGINE_ID=
ZETARIS_QUERY_LIMIT=1000
ZETARIS_TIMEOUT_SECONDS=60

# --- Models: Meterless Nightshift Runtime (app/adapters/meterless.py) ---
METERLESS_BASE_URL=https://your-meterless-runtime.example/v1
METERLESS_RUNTIME_TOKEN=your-runtime-token
METERLESS_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
METERLESS_TIMEOUT_SECONDS=60
METERLESS_MAX_TOKENS=2048

# --- Analyst (app/agents/analyst.py) ---
# "true" turns on the optional free-form SQL path (off by default).
ANALYST_FREE_SQL=false

# --- Critic (app/agents/critic.py, app/pipeline.py) ---
# "false" skips the Critic's model review call; its code checks always run.
CRITIC_MODEL_REVIEW=true

# --- League memory (app/agents/memory.py, H-MEM engine in app/engines/hmem.py) ---
# Folder for each user's memory records (default data/memory/, gitignored).
MEMORY_DIR=
